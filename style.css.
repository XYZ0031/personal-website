body {
    font-family: Arial;
    margin: 0;
    background: #f4f4f4;
}

header {
    background: #222;
    color: white;
    text-align: center;
    padding: 20px;
}

section {
    padding: 20px;
    margin: 10px;
    background: white;
    border-radius: 8px;
}

.about img {
    width: 150px;
    border-radius: 50%;
}

h2 {
    color: #333;
}

footer {
    text-align: center;
    padding: 10px;
    background: #222;
    color: white;
}
/* This makes the image a nice circle */
.profile-img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 20px auto;
    border: 4px solid #007bff;
}
/* This part styles the profile image specifically */
.profile-img {
    width: 200px;         /* Size of the photo */
    height: 200px;        /* Must match width for a circle */
    border-radius: 50%;   /* This creates the circular shape */
    object-fit: cover;    /* Ensures the face isn't stretched */
    display: block;       /* Centers the image */
    margin: 20px auto;    /* Adds space around the image */
    border: 5px solid #007bff; /* Adds a blue border around the circle */
    box-shadow: 0 4px 10px rgba(0,0,0,0.3); /* Adds a nice shadow */
}
