body {
    font-family: Arial;
    margin: 0;
    background: #f4f4f4;
}

header {
    background: #222;
    color: white;
    text-align: center;
    padding: 20px;
}

section {
    padding: 20px;
    margin: 10px;
    background: white;
    border-radius: 8px;
}

.about img {
    width: 150px;
    border-radius: 50%;
}

h2 {
    color: #333;
}

footer {
    text-align: center;
    padding: 10px;
    background: #222;
    color: white;
}
/* This makes the image a nice circle */
.profile-img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 20px auto;
    border: 4px solid #007bff;
}
